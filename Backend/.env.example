# ============================================================
# FILMY AI Backend — Environment Configuration
# ============================================================
# Fill in your real values before running the server.
# DO NOT commit this file with secrets to version control.

# MongoDB connection string (e.g., MongoDB Atlas or local)
MONGO_URI=

# JWT signing secret — use a long random string in production
JWT_SECRET=

# ImageKit credentials (from https://imagekit.io/dashboard)
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=

# Server port (default: 3000)
PORT=3000

# CORS: URL of your Next.js frontend (e.g., http://localhost:4000)
# Leave empty to allow all origins in development
FRONTEND_URL=

