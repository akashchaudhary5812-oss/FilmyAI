# ============================================================
# FILMY AI — Frontend Environment Configuration
# ============================================================

# The deployed/public backend API URL (Node.js / Express server)
# DO NOT hardcode localhost or invent backend URLs.
# Configure this with your actual backend deployment domain:
NEXT_PUBLIC_API_BASE_URL=

# Secondary FastAPI Report Engine URL (LLM_FINAL_REPORT service)
# Defaults to empty, can be set to deployed AI service or proxied:
NEXT_PUBLIC_REPORT_API_BASE_URL=
